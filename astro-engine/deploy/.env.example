# Copy to deploy/.env on the VPS and fill in real values there.
# deploy/.env is gitignored — never commit real keys.
#
# Leave a var blank (or omit deploy/.env entirely) to keep that gateway
# on the dummy mock adapter. See ../backend/payment/GATEWAYS.md.

PAYMENT_PROVIDER=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Report delivery + future opt-in emails. Leave blank to keep writing to
# the outbox instead of actually sending. Requires astro.arvelos.cloud
# (or whichever domain RESEND_FROM uses) to be verified in the Resend
# dashboard first — sending fails for real customers otherwise.
RESEND_API_KEY=
RESEND_FROM=Arvelos <reports@astro.arvelos.cloud>
